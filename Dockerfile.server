# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY server/package*.json ./server/

# Instalar dependencias completas del monorepo (shared + server)
RUN npm ci --include-workspace-root --workspace=shared --workspace=server

# Copiar código fuente
COPY shared/ ./shared/
COPY server/ ./server/

# Compilar shared y server
RUN npm run build --workspace=shared
RUN npm run build --workspace=server

# Stage 2: Runtime de producción liviano
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

# Usuario no privilegiado para seguridad
USER node

# Copiar package manifests
COPY --chown=node:node package*.json ./
COPY --chown=node:node shared/package*.json ./shared/
COPY --chown=node:node server/package*.json ./server/

# Instalar solo dependencias de producción
RUN npm ci --omit=dev --workspace=shared --workspace=server

# Copiar dist compilado
COPY --chown=node:node --from=builder /app/shared/dist ./shared/dist
COPY --chown=node:node --from=builder /app/server/dist ./server/dist

EXPOSE 4000

CMD ["node", "server/dist/index.js"]
